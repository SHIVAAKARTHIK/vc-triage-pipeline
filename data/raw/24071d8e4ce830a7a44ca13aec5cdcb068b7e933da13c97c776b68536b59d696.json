b-0.5 transition-opacity hover:opacity-50\" href=\"mailto:founders@quantstruct.com?subject=Housekeeping%20robot%20pilot\">Pilot inquiry</a></nav></header><section class=\"relative grid min-h-[calc(100svh-4rem)] border-b border-[#171712] lg:grid-cols-[1.15fr_0.85fr]\"><div class=\"hk-hero-column min-w-0 flex flex-col justify-between border-b border-[#171712] px-5 py-8 lg:border-b-0 lg:border-r lg:px-10 lg:py-10\"><div class=\"hk-reveal flex items-center justify-between text-[10px] font-bold uppercase tracking-[0.16em] md:text-[11px]\"><span>Robotics // Hospitality</span><span>San Francisco, CA</span></div><div class=\"py-16 lg:py-10\"><p class=\"hk-reveal hk-delay-1 mb-6 max-w-md text-xs uppercase leading-relaxed tracking-[0.12em] text-[#5d5a50]\">Physical automation for the work between check-out and room-ready.</p><h1 class=\"hk-hero-title hk-reveal hk-delay-2 max-w-full font-medium uppercase leading-[0.82] tracking-[-0.09em]\">Robots for housekeeping.</h1></div><div class=\"hk-reveal hk-delay-3 flex flex-col gap-7 border-t border-[#171712] pt-6 md:flex-row md:items-end md:justify-between\"><p class=\"max-w-xl text-sm leading-relaxed md:text-base\">We are building robotic systems for repetitive, physically demanding housekeeping work—starting with linen folding, then bed turnover and bathroom cleaning.</p><a class=\"group flex shrink-0 items-center gap-4 text-xs font-bold uppercase tracking-[0.14em]\" href=\"mailto:founders@quantstruct.com?subject=Housekeeping%20robot%20pilot\">Discuss a pilot<span class=\"inline-block transition-transform group-hover:translate-x-1\">→</span></a></div></div><div class=\"hk-scan relative flex min-h-[430px] min-w-0 items-center justify-center overflow-hidden px-5 py-14 lg:min-h-0\"><div class=\"absolute inset-x-5 top-5 flex justify-between text-[9px] uppercase tracking-[0.14em] text-[#6f6b5e] lg:inset-x-8\"><span>Unit HSK-01</span><span>Operational study</span></div><svg class=\"hk-robot h-auto w-full max-w-[620px] select-none\" viewBox=\"0 0 560 390\" role=\"img\" aria-labelledby=\"housekeeping-robot-title housekeeping-robot-description\"><title id=\"housekeeping-robot-title\">Housekeeping robot study</title><desc id=\"housekeeping-robot-description\">A line drawing of a robot connected to linen folding, room turnover, and bathroom cleaning tasks.</desc><g fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" vector-effect=\"non-scaling-stroke\" stroke-linecap=\"square\" stroke-linejoin=\"miter\"><rect x=\"110\" y=\"20\" width=\"340\" height=\"100\"></rect><circle cx=\"180\" cy=\"65\" r=\"7\"></circle><circle cx=\"380\" cy=\"65\" r=\"7\"></circle><circle cx=\"180\" cy=\"65\" r=\"2.5\" fill=\"currentColor\"></circle><circle cx=\"380\" cy=\"65\" r=\"2.5\" fill=\"currentColor\"></circle><path d=\"M272 88h16l-3 6h-16z\"></path><path d=\"M280 120v30\"></path><path d=\"M245 150v-13h70v13\"></path><rect x=\"220\" y=\"150\" width=\"120\" height=\"125\"></rect><path d=\"M220 180h-90v50\"></path><path d=\"M340 180h90v50\"></path><path d=\"M130 230H90v20\"></path><path d=\"M430 230h40v20\"></path><rect x=\"40\" y=\"250\" width=\"100\" height=\"65\"></rect><rect x=\"420\" y=\"250\" width=\"100\" height=\"65\"></rect><path d=\"M250 275l-28 65\"></path><path d=\"M310 275l28 65\"></path><path d=\"M90 315v25\"></path><path d=\"M470 315v25\"></path><path d=\"M20 340h520\"></path><path d=\"M20 346h520\"></path><path d=\"M90 330v16M220 330v16M340 330v16M470 330v16\"></path></g><g fill=\"currentColor\" text-anchor=\"middle\"><text x=\"280\" y=\"205\" font-size=\"22\" font-weight=\"600\">HSK</text><text x=\"280\" y=\"232\" font-size=\"22\" font-weight=\"600\">01</text><text x=\"90\" y=\"289\" font-size=\"21\">fold</text><text x=\"470\" y=\"289\" font-size=\"21\">clean</text><text x=\"90\" y=\"380\" font-size=\"20\" font-weight=\"600\">LINEN</text><text x=\"280\" y=\"380\" font-size=\"20\" font-weight=\"600\">ROOM</text><text x=\"470\" y=\"380\" font-size=\"20\" font-weight=\"600\">BATH</text></g></svg><div class=\"absolute inset-x-5 bottom-5 flex justify-between text-[9px] uppercase tracking-[0.14em] text-[#6f6b5e] lg:inset-x-8\"><span>Human handoff on edge cases</span><span>v0.1</span></div></div></section><section id=\"work\" class=\"px-5 py-20 md:px-10 md:py-28\"><div class=\"mb-14 grid gap-7 md:grid-cols-[0.7fr_1.3fr] md:items-end\"><p class=\"text-[10px] font-bold uppercase tracking-[0.16em]\">Target workflows // 01—03</p><h2 class=\"max-w-4xl text-[clamp(2.2rem,5.5vw,5.5rem)] font-medium uppercase leading-[0.9] tracking-[-0.065em]\">Start in the linen room. Earn the guest room.</h2></div><div class=\"border-t border-[#171712]\"><article class=\"hk-work-row grid gap-5 border-b border-[#171712] py-7 transition-colors md:grid-cols-[0.18fr_0.62fr_1fr_0.4fr] md:items-start md:gap-8 md:py-9\"><span class=\"text-xs\">[<!-- -->01<!-- -->]</span><h3 class=\"text-2xl font-medium uppercase leading-none tracking-[-0.045em] md:text-3xl\">Linen handling</h3><p class=\"max-w-2xl text-sm leading-relaxed text-[#4e4b42] md:text-base\">Identify, sort, and fold towels, pillowcases, napkins, and sheets for the next room turn.</p><span class=\"text-[10px] font-bold uppercase tracking-[0.12em] md:text-right\">first deployment wedge</span></article><article class=\"hk-work-row grid gap-5 border-b border-[#171712] py-7 transition-colors md:grid-cols-[0.18fr_0.62fr_1fr_0.4fr] md:items-start md:gap-8 md:py-9\"><span class=\"text-xs\">[<!-- -->02<!-- -->]</span><h3 class=\"text-2xl font-medium uppercase leading-none tracking-[-0.045em] md:text-3xl\">Bed turnover</h3><p class=\"max-w-2xl text-sm leading-relaxed text-[#4e4b42] md:text-base\">Strip used linen, stage clean sets, and remake beds to a consistent property standard.</p><span class=\"text-[10px] font-bold uppercase tracking-[0.12em] md:text-right\">in development</span></article><article class=\"hk-work-row grid gap-5 border-b border-[#171712] py-7 transition-colors md:grid-cols-[0.18fr_0.62fr_1fr_0.4fr] md:items-start md:gap-8 md:py-9\"><span class=\"text-xs\">[<!-- -->03<!-- -->]</span><h3 class=\"text-2xl font-medium uppercase leading-none tracking-[-0.045em] md:text-3xl\">Bathroom reset</h3><p class=\"max-w-2xl text-sm leading-relaxed text-[#4e4b42] md:text-base\">Clean and disinfect toilets, showers, sinks, mirrors, and floors between guests.</p><span class=\"text-[10px] font-bold uppercase tracking-[0.12em] md:text-right\">in development</span></article></div></section><section id=\"system\" class=\"border-y border-[#171712] bg-[#171712] px-5 py-20 text-[#f3eedf] md:px-10 md:py-28\"><div class=\"grid gap-14 lg:grid-cols-[0.8fr_1.2fr]\"><div><p class=\"mb-8 text-[10px] font-bold uppercase tracking-[0.16em] text-[#b7b19f]\">Operating model</p><h2 class=\"max-w-[9ch] text-[clamp(2.7rem,6vw,6.4rem)] font-medium uppercase leading-[0.86] tracking-[-0.07em]\">One system. Messy rooms.</h2></div><div class=\"flex flex-col justify-end\"><p class=\"mb-12 max-w-2xl text-sm leading-relaxed text-[#c9c3b1] md:text-base\">The system is designed to work inside existing hotel operations: receive the room state, execute a constrained task, ask for help when confidence is low, and leave a verifiable handoff.</p><ol class=\"border-t border-[#777264]\"><li class=\"flex items-center justify-between border-b border-[#777264] py-4 text-xs uppercase tracking-[0.12em]\"><span>01 // checkout</span><span aria-hidden=\"true\">↓</span></li><li class=\"flex items-center justify-between border-b border-[#777264] py-4 text-xs uppercase tracking-[0.12em]\"><span>02 // room scan</span><span aria-hidden=\"true\">↓</span></li><li class=\"flex items-center justify-between border-b border-[#777264] py-4 text-xs uppercase tracking-[0.12em]\"><span>03 // task execution</span><span aria-hidden=\"true\">↓</span></li><li class=\"flex items-center justify-between border-b border-[#777264] py-4 text-xs uppercase tracking-[0.12em]\"><span>04 // quality check</span><span aria-hidden=\"true\">↓</span></li><li class=\"flex items-center justify-between border-b border-[#777264] py-4 text-xs uppercase tracking-[0.12em]\"><span>05 // room ready</span><span aria-hidden=\"true\">■</span></li></ol></div></div></section><section class=\"grid border-b border-[#171712] lg:grid-cols-2\"><div class=\"border-b border-[#171712] px-5 py-20 lg:border-b-0 lg:border-r lg:px-10 lg:py-24\"><p class=\"mb-8 text-[10px] font-bold uppercase tracking-[0.16em]\">Pilot measure</p><p class=\"max-w-xl text-2xl leading-tight tracking-[-0.035em] md:text-4xl\">Minutes returned to the shift. Fewer blocked rooms. Consistent quality without redesigning the property.</p></div><div class=\"flex flex-col justify-between gap-14 px-5 py-20 lg:px-10 lg:py-24\"><p class=\"max-w-xl text-sm leading-relaxed text-[#4e4b42] md:text-base\">We are looking for hotel operators and commercial laundry teams willing to map the workflow, provide shadowing access, and define a narrow paid pilot around one high-friction task.</p><a class=\"group flex items-center justify-between border-t border-[#171712] pt-5 text-xs font-bold uppercase tracking-[0.14em]\" href=\"mailto:founders@quantstruct.com?subject=Housekeeping%20robot%20pilot\">founders@quantstruct.com<span class=\"inline-block text-xl transition-transform group-hover:translate-x-1\">→</span></a></div></section><footer class=\"flex flex-col gap-5 px-5 py-7 text-[9px] font-bold uppercase tracking-[0.14em] md:flex-row md:items-center md:justify-between md:px-10\"><span>Quantstruct, Inc. // 2026</span><div class=\"flex gap-6\"><a class=\"hover:underline\" href=\"/app\">Laundry control</a><a class=\"hover:underline\" href=\"/backup\">Previous site</a><a class=\"hover:underline\" href=\"/privacy-policy\">Privacy</a></div></footer></main><!--$--><!--/$--><!--$!--><template data-dgst=\"BAILOUT_TO_CLIENT_SIDE_RENDERING\"></template><!--/$--><script src=\"/_next/static/chunks/webpack-2fb0c7dafee6a30d.js?dpl=dpl_BeC3Yd8umhdM7Z7NDtWKkcXFUCv8\" async=\"\"></script><script>(self.__next_f=self.__next_f||[]).push([0