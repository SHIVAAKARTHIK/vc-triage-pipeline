  "text": "<!doctype html>\n<!-- @dsCard group=\"UI Kit — Website\" name=\"Website — homepage\" subtitle=\"Centered hero, blue logo, email capture, count-up ROI\" viewport=\"1280x860\" -->\n<html lang=\"en\">\n  <head>\n    <meta charset=\"utf-8\" />\n    <meta name=\"viewport\" content=\"width=device-width, initial-scale=1\" />\n    <title>Mesh - Accrual Automation Software</title>\n    <link rel=\"icon\" type=\"image/png\" href=\"assets/mesh-mark-blue.png\" />\n    <meta\n      name=\"description\"\n      content=\"Mesh replaces accrual spreadsheets with auditable scripts, aggregating real-time signals from your procurement system, AP inbox, Slack, and Teams.\"\n    />\n    <meta\n      name=\"keywords\"\n      content=\"accrual automation, month-end close, accrual software, auditable accruals, ERP automation, audit trail, accounting automation, close automation\"\n    />\n    <meta name=\"robots\" content=\"index, follow\" />\n    <link rel=\"canonical\" href=\"https://usemesh.com/\" />\n\n    <!-- Open Graph -->\n    <meta property=\"og:type\" content=\"website\" />\n    <meta property=\"og:title\" content=\"Mesh - Accrual Automation Software\" />\n    <meta\n      property=\"og:description\"\n      content=\"Mesh replaces accrual spreadsheets with auditable scripts, aggregating real-time signals from your procurement system, AP inbox, Slack, and Teams.\"\n    />\n    <meta property=\"og:url\" content=\"https://usemesh.com/\" />\n    <meta property=\"og:site_name\" content=\"Mesh\" />\n    <meta\n      property=\"og:image\"\n      content=\"https://usemesh.com/assets/og/og-hero.jpg\"\n    />\n    <meta property=\"og:image:width\" content=\"1200\" />\n    <meta property=\"og:image:height\" content=\"630\" />\n\n    <!-- Twitter -->\n    <meta name=\"twitter:card\" content=\"summary_large_image\" />\n    <meta\n      name=\"twitter:title\"\n      content=\"Mesh - Accrual Automation Software\"\n    />\n    <meta\n      name=\"twitter:description\"\n      content=\"Mesh replaces accrual spreadsheets with auditable scripts, aggregating real-time signals from your procurement system, AP inbox, Slack, and Teams.\"\n    />\n    <meta name=\"twitter:site\" content=\"@usemesh\" />\n    <meta\n      name=\"twitter:image\"\n      content=\"https://usemesh.com/assets/og/og-hero.jpg\"\n    />\n\n    <script type=\"application/ld+json\">\n    {\n      \"@context\": \"https://schema.org\",\n      \"@type\": \"Organization\",\n      \"name\": \"Mesh\",\n      \"url\": \"https://usemesh.com/\",\n      \"logo\": \"https://usemesh.com/assets/mesh-logo-blue.png\",\n      \"description\": \"Mesh is an accrual automation platform for finance and accounting teams, replacing manual accrual spreadsheets with auditable, policy-driven scripts for month-end close. Backed by Y Combinator (W25).\",\n      \"sameAs\": [\n        \"https://www.linkedin.com/company/usemesh\",\n        \"https://www.ycombinator.com/companies/mesh-2\"\n      ]\n    }\n    </script>\n    <script type=\"application/ld+json\">\n    {\n      \"@context\": \"https://schema.org\",\n      \"@type\": \"SoftwareApplication\",\n      \"name\": \"Mesh\",\n      \"applicationCategory\": \"FinanceApplication\",\n      \"operatingSystem\": \"Web\",\n      \"url\": \"https://usemesh.com/\",\n      \"description\": \"Mesh replaces accrual spreadsheets with auditable scripts, aggregating real-time signals from your procurement system, AP inbox, Slack, and Teams.\",\n      \"image\": \"https://usemesh.com/assets/og/og-hero.jpg\",\n      \"provider\": {\n        \"@type\": \"Organization\",\n        \"name\": \"Mesh\",\n        \"url\": \"https://usemesh.com/\"\n      }\n    }\n    </script>\n    <script type=\"application/ld+json\">\n    {\n      \"@context\": \"https://schema.org\",\n      \"@type\": \"Review\",\n      \"name\": \"DoorDash on redesigning a large accrual workflow with Mesh\",\n      \"url\": \"https://usemesh.com/#why-mesh\",\n      \"inLanguage\": \"en\",\n      \"itemReviewed\": {\n        \"@type\": \"SoftwareApplication\",\n        \"name\": \"Mesh\",\n        \"applicationCategory\": \"FinanceApplication\",\n        \"operatingSystem\": \"Web\",\n        \"url\": \"https://usemesh.com/\"\n      },\n      \"author\": {\n        \"@type\": \"Person\",\n        \"name\": \"Christine Lafite\",\n        \"honorificSuffix\": \"CPA\",\n        \"jobTitle\": \"Senior Manager, Accounting\",\n        \"worksFor\": {\n          \"@type\": \"Organization\",\n          \"name\": \"DoorDash\",\n          \"url\": \"https://www.doordash.com/\"\n        }\n      },\n      \"publisher\": {\n        \"@type\": \"Organization\",\n        \"name\": \"Mesh\",\n        \"url\": \"https://usemesh.com/\"\n      },\n      \"reviewBody\": \"Accounting automation works best when it starts with a deep understanding of the underlying systems, processes, and controls. As we bring more structure, auditability, and visibility to one of our largest accrual workflows, Mesh has been a great partner in helping us think through both the system design and automation layer. The Mesh team has felt like an extension of our team through this end-to-end redesign.\"\n    }\n    </script>\n    <script type=\"application/ld+json\">\n    {\n      \"@context\": \"https://schema.org\",\n      \"@type\": \"WebSite\",\n      \"name\": \"Mesh\",\n      \"alternateName\": [\"Mesh Accrual Automation\"],\n      \"url\": \"https://usemesh.com/\"\n    }\n    </script>\n    <script type=\"application/ld+json\">\n    {\n      \"@context\": \"https://schema.org\",\n      \"@type\": \"FAQPage\",\n      \"mainEntity\": [\n        { \"@type\": \"Question\", \"name\": \"Are you SOC 2 compliant, and where is our data stored?\", \"acceptedAnswer\": { \"@type\": \"Answer\", \"text\": \"Yes, Mesh is SOC 2 Type II certified, audited annually by an independent third party. Your data is encrypted in transit and at rest and hosted in US-based AWS regions. Access is least-privilege by default, and we never train shared models on your financial data. Regional data residency is available on enterprise plans.\" } },\n        { \"@type\": \"Question\", \"name\": \"Do we still get human review before anything posts to the ERP?\", \"acceptedAnswer\": { \"@type\": \"Answer\", \"text\": \"Always. Mesh never posts to your ERP on its own. Every accrual it drafts lands in a review queue where your team approves, edits, or rejects it before anything syncs. You remain as the system of record, Mesh handles gathering, calculation, and documentation, and your controllers keep the final sign-off.\" } },\n        { \"@type\": \"Question\", \"name\": \"We tried building this internally, why is Mesh different?\", \"acceptedAnswer\": { \"@type\": \"Answer\", \"text\": \"Most internal builds stall on maintenance, not the first version. Mesh maintains the connectors, judgment logic, and audit trail as your vendors, ERP, and team change, so it does not rot the moment its author leaves. You get versioned rules, exception flagging, and full lineage out of the box, not a brittle script to babysit.\" } },\n        { \"@type\": \"Question\", \"name\": \"Can we run a lightweight proof of concept first?\", \"acceptedAnswer\": { \"@type\": \"Answer\", \"text\": \"Yes. Most teams start with a focused proof of concept on one entity or a handful of vendors, using recent close workbook(s) you already trust. It takes days, not months: we connect read-only, replay the period, and you compare Mesh’s output against your own. No rip-and-replace required to see the value.\" } },\n        { \"@type\": \"Question\", \"name\": \"What does implementation actually require from us?\", \"acceptedAnswer\": { \"@type\": \"Answer\", \"text\": \"We connect to your ERP and procurement systems (i.e. Coupa, Zip) with read-only access, then sit with your team to encode your existing accrual logic once. Most teams run their first Mesh-assisted close within weeks, resulting in minimal disruption to your close cycles.\" } }\n      ]\n    }\n    </script>\n\n    <link rel=\"stylesheet\" href=\"colors_and_type.css\" />\n    <link rel=\"stylesheet\" href=\"kit.css\" />\n    <link rel=\"stylesheet\" href=\"meshv6.css\" />\n\n    <!-- Assets referenced as strings in JSX (lifted for standalone bundling) -->\n    <meta\n      name=\"ext-resource-dependency\"\n      content=\"assets/ycombinator.svg\"\n      data-resource-id=\"ycombinator.svg\"\n    />\n    <meta\n      name=\"ext-resource-dependency\"\n      content=\"assets/aicpa-soc.png\"\n      data-resource-id=\"aicpa-soc.png\"\n    />\n    <meta\n      name=\"ext-resource-dependency\"\n      content=\"assets/mesh-logo-blue.png\"\n      data-resource-id=\"mesh-logo-blue.png\"\n    />\n    <meta\n      name=\"ext-resource-dependency\"\n      content=\"assets/mesh-logo-white.png\"\n      data-resource-id=\"mesh-logo-white.png\"\n    />\n    <meta\n      name=\"ext-resource-dependency\"\n      content=\"assets/mesh-logo-ink.png\"\n      data-resource-id=\"mesh-logo-ink.png\"\n    />\n    <meta\n      name=\"ext-resource-dependency\"\n      content=\"assets/mesh-mark-blue.png\"\n      data-resource-id=\"mesh-mark-blue.png\"\n    />\n    <meta\n      name=\"ext-resource-dependency\"\n      content=\"assets/christine-doordash.jpg\"\n      data-resource-id=\"christine-doordash.jpg\"\n    />\n    <meta\n      name=\"ext-resource-dependency\"\n      content=\"assets/mesh-mark-white.png\"\n      data-resource-id=\"mesh-mark-white.png\"\n    />\n    <meta\n      name=\"ext-resource-dependency\"\n      content=\"assets/mesh-mark-ink.png\"\n      data-resource-id=\"mesh-mark-ink.png\"\n    />\n    <meta\n      name=\"ext-resource-dependency\"\n      content=\"assets/logos/doordash.png\"\n      data-resource-id=\"logos/doordash.png\"\n    />\n    <meta\n      name=\"ext-resource-dependency\"\n      content=\"assets/logos/carta.png\"\n      data-resource-id=\"logos/carta.png\"\n    />\n    <meta\n      name=\"ext-resource-dependency\"\n      content=\"